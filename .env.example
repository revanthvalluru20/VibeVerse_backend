# ============================================================
# VibeVerse Backend Environment Variables
# ============================================================

# Server Port (Render/Railway/Heroku automatically injects PORT)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/VibeVerse?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL (CORS & Socket.IO whitelist)
# In production, set this to your deployed frontend domain (e.g. Vercel)
# Multiple origins can be comma-separated: e.g. https://VibeVerse.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend-app.vercel.app

# Cookie SameSite setting:
# Use 'none' for separate cross-domain deployments (e.g. Vercel frontend + Render backend)
# Use 'lax' for local development or same-domain deployments
COOKIE_SAME_SITE=none

# Nodemailer / Gmail SMTP Configuration for OTPs & Verification
# Note: EMAIL_PASS must be a 16-character Gmail App Password (NOT your normal Gmail password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# Cloudinary Storage Configuration for Avatar & Media Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

